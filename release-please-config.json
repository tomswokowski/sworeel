{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "sworeel",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugin/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugin/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugin/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "src-tauri/Cargo.lock", "jsonpath": "$.package[?(@.name.value=='sworeel')].version" }
      ]
    }
  }
}
