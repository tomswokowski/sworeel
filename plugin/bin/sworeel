#!/usr/bin/env bash
# Runs the sworeel CLI. Node executes the TypeScript source directly.
set -e

# Find this script's real folder, following a symlink to it. `readlink -f` is not on every
# system, so the link is followed by hand.
script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
  target="$(readlink "$script")"
  case "$target" in
    /*) script="$target" ;;
    *) script="$(dirname "$script")/$target" ;;
  esac
done
root="$(cd "$(dirname "$script")/.." && pwd)"
if [ ! -f "$root/cli/main.ts" ]; then
  echo "sworeel: could not find its own files next to $script." >&2
  exit 1
fi

# Desktop launchers may not have a version manager's Node on PATH. Then, if mise is there, Node
# is run through it. Each command is written out in full, so it is plain what runs.
use_mise=
if ! command -v node >/dev/null && command -v mise >/dev/null; then use_mise=1; fi
run_node() { if [ -n "$use_mise" ]; then mise exec node -- node "$@"; else node "$@"; fi; }
run_npm() { if [ -n "$use_mise" ]; then mise exec node -- npm "$@"; else npm "$@"; fi; }

if ! run_node "$root/cli/check-node.mjs" 2>/dev/null; then
  echo "sworeel needs Node.js 22.18 or newer." >&2
  exit 1
fi

# A freshly installed plugin has no dependencies yet; fetch them once. The marker is written
# only when the install finishes, so one cut short is tried again next time.
if [ ! -f "$root/node_modules/.sworeel-installed" ]; then
  echo "sworeel: installing dependencies (first run only)..." >&2
  (cd "$root" && run_npm install --omit=dev --no-audit --no-fund --loglevel=error) >&2
  touch "$root/node_modules/.sworeel-installed"
fi

if [ -n "$use_mise" ]; then
  exec mise exec node -- node "$root/cli/main.ts" "$@"
fi
exec node "$root/cli/main.ts" "$@"
